# ===== 大模型 API 配置 =====

# OpenAI 官方 API Key（获取地址：https://platform.openai.com/api-keys）
OPENAI_API_KEY=sk-你的key

# 可选：使用 OpenAI 兼容接口的其它服务商
# 例如 DeepSeek：https://api.deepseek.com/v1
# 例如 通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# 可选：模型名（默认 gpt-4o-mini / text-embedding-3-small）
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
